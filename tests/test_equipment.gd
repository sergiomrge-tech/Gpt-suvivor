extends SceneTree

func _initialize() -> void:
    var state := SurvivorState.new()
    assert(str(state.equipment["main_hand"]) == "")
    assert(not state.equip("axe"))
    assert(state.required_tool("tree") == "axe")
    assert(state.required_tool("rock") == "pickaxe")
    assert(state.required_tool("fiber_bundle") == "")
    state.add_item("wood", 12)
    state.add_item("stone", 12)
    state.add_item("fiber", 12)
    assert(state.craft("axe"))
    assert(state.equip("axe"))
    assert(state.is_equipped("axe"))
    assert(state.craft("pickaxe"))
    assert(state.equip("pickaxe"))
    assert(not state.is_equipped("axe"))
    assert(state.is_equipped("pickaxe"))
    assert(state.craft("fishing_rod"))
    assert(state.item_count("fishing_rod") == 1)
    assert(not state.is_equipped("fishing_rod"))
    assert(state.equip("fishing_rod"))
    assert(state.is_equipped("fishing_rod"))
    assert(state.is_equipped("pickaxe"))
    assert(state.unequip("main_hand"))
    assert(not state.is_equipped("fishing_rod"))
    assert(state.equip("fishing_rod"))
    var serialized: Dictionary = state.to_dict()
    assert(int(serialized["version"]) == 2)
    var copy := SurvivorState.new()
    assert(copy.from_dict(serialized))
    assert(copy.is_equipped("fishing_rod"))
    assert(copy.is_equipped("pickaxe"))
    var old_save := {"version": 1, "inventory": {"spear": 1, "wood": 3}, "crafted": {"campfire": 1}}
    var migrated := SurvivorState.new()
    assert(migrated.from_dict(old_save))
    assert(migrated.is_equipped("spear"))
    assert(int(migrated.to_dict()["version"]) == 2)
    assert(migrated.crafted.get("campfire", 0) == 1)
    var broken := {"version": 2, "inventory": {"fishing_rod": 0}, "equipment": {"main_hand": "fishing_rod"}, "crafted": {}}
    assert(copy.from_dict(broken))
    assert(not copy.is_equipped("fishing_rod"))
    print("EQUIPMENT AND SAVE MIGRATION: OK")
    quit(0)
